# Copie para .env e preencha com os valores do seu projeto Supabase
# (Project Settings -> API). .env nunca é commitado (ver .gitignore).

# Postgres gerenciado pelo Supabase. Sem essa var, a API cai para um
# arquivo SQLite local (./certfly.db) — suficiente pra rodar localmente e
# pra suíte de testes, sem precisar de um Supabase real (ver app/repository/db.py).
# DATABASE_URL=postgresql+psycopg://postgres:<senha>@<host>:5432/postgres

# URL do projeto Supabase (Project Settings -> API -> Project URL). Usada
# pra validar o JWT via JWKS público (ver app/auth.py) — projetos novos
# assinam com chave assimétrica (ES256), não com um secret compartilhado.
SUPABASE_URL=https://bmrucxfofwbcyyhgrzqt.supabase.co

# Dev-only: permite tokens HS256 assinados localmente (scripts/seed_dev.py)
# sem bater no Supabase de verdade. Nunca setar isso em produção — lá só
# SUPABASE_URL deve existir, pra garantir que só tokens ES256 reais validam.
SUPABASE_JWT_SECRET=dev-only-secret-nao-usar-em-producao
